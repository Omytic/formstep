# ── Herkese açık ──
NEXT_PUBLIC_SITE_URL=https://formstep.tr
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GA_ID=
# Şimdilik kapalı (boş bırak). 1 yapınca sitede satış / müşteri üyeliği açılır. Bkz. lib/features.ts
NEXT_PUBLIC_SALES_ENABLED=
NEXT_PUBLIC_ACCOUNTS_ENABLED=

# ── Yalnızca sunucu (asla NEXT_PUBLIC_ ile başlatma) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── Yalnızca satış açılınca gerekir ──
# FormStep'in KENDİ PayTR mağazası (SERYN'inkiler değil)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test ödemesi, 0 = canlı
PAYTR_TEST_MODE=1

# İşlemsel e-posta (Resend)
RESEND_API_KEY=
EMAIL_FROM="FormStep <info@omytic.com>"

# Vercel Cron korumak için uzun rastgele bir değer
CRON_SECRET=
